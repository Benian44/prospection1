---
interface FAQ {
  question: string;
  answer: string;
  category: string;
}

const faqs: FAQ[] = [
  {
    category: "Construction",
    question: "Comment obtenir un devis pour une construction ?",
    answer: "Pour obtenir un devis de construction, nous aurons besoin des informations suivantes :\n- Type de construction\n- Surface approximative\n- Localisation\n- Budget estimatif\nUn de nos experts vous contactera dans les plus brefs délais."
  },
  {
    category: "Menuiserie",
    question: "Quels types de menuiserie aluminium proposez-vous ?",
    answer: "Nous proposons une large gamme de menuiserie aluminium :\n- Portes et fenêtres\n- Baies vitrées\n- Vérandas\n- Garde-corps\n- Portails\nTous nos produits sont personnalisables selon vos besoins."
  },
  {
    category: "Plafonds",
    question: "Quel est le délai pour l'installation d'un plafond staff ?",
    answer: "Le délai d'installation d'un plafond staff dépend de plusieurs facteurs :\n- Surface à couvrir\n- Complexité du design\n- Accessibilité du chantier\nEn moyenne, comptez 1 à 2 semaines pour une installation standard."
  },
  {
    category: "Gestion Immobilière",
    question: "Quels sont vos services en gestion immobilière ?",
    answer: "Nos services de gestion immobilière comprennent :\n- Location et gestion locative\n- Maintenance des biens\n- Suivi des paiements\n- Gestion administrative\n- Reporting mensuel"
  },
  {
    category: "Maintenance",
    question: "Comment programmer une intervention de maintenance ?",
    answer: "Pour programmer une intervention :\n1. Décrivez le problème\n2. Indiquez vos disponibilités\n3. Fournissez l'adresse exacte\nNous vous proposerons un rendez-vous sous 24-48h."
  }
];

const whatsappNumber = "+22570771650";
---

<div id="whatsapp-chat" class="fixed bottom-24 right-6 z-40 w-80 bg-white dark:bg-gray-800 rounded-lg shadow-xl hidden">
  <div class="p-4 bg-primary text-white rounded-t-lg">
    <h3 class="font-semibold text-lg">Comment pouvons-nous vous aider ?</h3>
    <p class="text-sm text-gray-100">Choisissez une option ou posez votre question</p>
  </div>
  
  <div class="p-4 space-y-3 max-h-96 overflow-y-auto">
    {faqs.map((faq) => (
      <button 
        class="w-full text-left p-3 rounded-lg bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors"
        data-question={faq.question}
        data-answer={faq.answer}
      >
        <p class="text-sm font-medium text-gray-900 dark:text-white">{faq.question}</p>
        <span class="text-xs text-gray-500 dark:text-gray-400">{faq.category}</span>
      </button>
    ))}
    
    <button 
      class="w-full text-left p-3 rounded-lg bg-secondary text-white hover:bg-secondary-600 transition-colors"
      id="contact-agent"
    >
      Autre question ? Contactez un conseiller
    </button>
  </div>
</div>

<button 
  id="toggle-chat"
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-secondary text-white rounded-full shadow-lg hover:bg-secondary-600 transition-colors"
  aria-label="Ouvrir le chat WhatsApp"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</button>

<script define:vars={{ whatsappNumber, faqs }}>
  document.addEventListener('DOMContentLoaded', () => {
    const chatButton = document.getElementById('toggle-chat');
    const chatWindow = document.getElementById('whatsapp-chat');
    const contactAgent = document.getElementById('contact-agent');
    
    chatButton?.addEventListener('click', () => {
      chatWindow?.classList.toggle('hidden');
    });
    
    document.querySelectorAll('[data-question]').forEach(button => {
      button.addEventListener('click', () => {
        const question = button.getAttribute('data-question');
        const answer = button.getAttribute('data-answer');
        
        if (question && answer) {
          const message = `Question : ${question}\n\nRéponse automatique :\n${answer}\n\nJ'aimerais plus d'informations à ce sujet.`;
          window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`, '_blank');
        }
      });
    });
    
    contactAgent?.addEventListener('click', () => {
      const message = "Bonjour, j'aimerais parler à un conseiller IBS SARL concernant vos services.";
      window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`, '_blank');
    });
  });
</script>