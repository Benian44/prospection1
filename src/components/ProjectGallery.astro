---
interface Project {
  title: string;
  category: string;
  image: string;
  href: string;
}

const projects: Project[] = [
  {
    title: "Villa moderne à Cocody",
    category: "Construction",
    image: "https://images.pexels.com/photos/323780/pexels-photo-323780.jpeg?auto=compress&cs=tinysrgb&h=750&w=1260",
    href: "/realisations#villa-cocody"
  },
  {
    title: "Baies vitrées pour bureaux",
    category: "Menuiserie Aluminium",
    image: "https://images.pexels.com/photos/380768/pexels-photo-380768.jpeg?auto=compress&cs=tinysrgb&h=750&w=1260",
    href: "/realisations#baies-bureaux"
  },
  {
    title: "Rampes inox pour résidence",
    category: "Rampes Inox",
    image: "https://images.pexels.com/photos/1249611/pexels-photo-1249611.jpeg?auto=compress&cs=tinysrgb&h=750&w=1260",
    href: "/realisations#rampes-residence"
  },
  {
    title: "Plafonds décoratifs restaurant",
    category: "Plafonds Staff",
    image: "https://images.pexels.com/photos/296883/pexels-photo-296883.jpeg?auto=compress&cs=tinysrgb&h=750&w=1260",
    href: "/realisations#plafonds-restaurant"
  }
];
---

<section class="py-16 bg-white dark:bg-gray-900">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4" data-aos="fade-up">
        Nos Réalisations
      </h2>
      <div class="h-1 w-20 bg-secondary mx-auto mb-6" data-aos="fade-up" data-aos-delay="100"></div>
      <p class="text-lg text-gray-600 dark:text-gray-300" data-aos="fade-up" data-aos-delay="200">
        Découvrez quelques-uns de nos projets récents qui témoignent de notre savoir-faire et de notre engagement pour l'excellence.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {projects.map((project, index) => (
        <a 
          href={project.href} 
          class="group block relative overflow-hidden rounded-lg shadow-md h-64"
          data-aos="fade-up"
          data-aos-delay={index * 100}
        >
          <img 
            src={project.image} 
            alt={project.title} 
            class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/90 to-transparent opacity-80 group-hover:opacity-95 transition-opacity duration-300"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <span class="text-secondary bg-white/10 text-xs font-medium px-2.5 py-1 rounded mb-2 inline-block">
              {project.category}
            </span>
            <h3 class="text-xl font-semibold text-white group-hover:text-secondary transition-colors duration-300">
              {project.title}
            </h3>
            <div class="mt-2 text-white/0 group-hover:text-white/100 transition-all duration-300 flex items-center text-sm">
              Voir le projet
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
    
    <div class="text-center mt-12">
      <a 
        href="/realisations" 
        class="inline-flex items-center px-6 py-3 border-2 border-primary text-primary hover:bg-primary hover:text-white font-medium rounded-md transition-colors duration-300"
        data-aos="fade-up"
      >
        Voir toutes nos réalisations
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>