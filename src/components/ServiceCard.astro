---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  image: string;
}

const { title, description, icon, href, image } = Astro.props;
---

<div class="group rounded-lg overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 bg-white dark:bg-gray-800" data-aos="fade-up">
  <div class="relative h-48 overflow-hidden">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
    <div class="absolute bottom-4 left-4 bg-primary text-white p-2 rounded-full">
      <Fragment set:html={icon} />
    </div>
  </div>
  
  <div class="p-6">
    <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">{title}</h3>
    <p class="text-gray-600 dark:text-gray-300 mb-4">{description}</p>
    <a 
      href={href} 
      class="inline-flex items-center font-medium text-primary dark:text-secondary hover:text-primary-700 dark:hover:text-secondary-400 transition-colors"
    >
      En savoir plus
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</div>