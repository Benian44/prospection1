---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
const contactNumbers = [
  "+225 27 22 49 80 16",
  "+225 07 07 71 65 05",
  "+225 05 55 36 96 13"
];

const services = [
  { name: "Construction & Rénovation", href: "/services#construction" },
  { name: "Menuiserie Aluminium", href: "/services#menuiserie" },
  { name: "Rampes en Inox", href: "/services#rampes" },
  { name: "Auvents", href: "/services#auvents" },
  { name: "Plafonds Staff", href: "/services#plafonds" },
  { name: "Gestion Immobilière", href: "/services#gestion" },
];
---

<footer class="bg-primary text-white pt-16 pb-8">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <Logo width={60} height={60} />
          <div>
            <h3 class="font-poppins font-bold text-xl">IBS SARL</h3>
            <p class="text-sm text-gray-200">Immobiliers Bâtiments et Services</p>
          </div>
        </div>
        <p class="text-gray-300 mt-4">
          L'excellence ivoirienne dans l'immobilier et la menuiserie aluminium.
        </p>
        <div class="flex items-center">
          <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-white/10 text-white rounded">
            Entreprise 100% ivoirienne
          </span>
        </div>
      </div>
      
      <!-- Services Links -->
      <div>
        <h3 class="font-poppins font-semibold text-lg mb-4">Nos Services</h3>
        <ul class="space-y-2">
          {services.map(service => (
            <li>
              <a 
                href={service.href} 
                class="text-gray-300 hover:text-white transition-colors duration-200 flex items-center"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-secondary" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h3 class="font-poppins font-semibold text-lg mb-4">Liens Rapides</h3>
        <ul class="space-y-2">
          <li>
            <a href="/a-propos" class="text-gray-300 hover:text-white transition-colors duration-200">À Propos</a>
          </li>
          <li>
            <a href="/realisations" class="text-gray-300 hover:text-white transition-colors duration-200">Nos Réalisations</a>
          </li>
          <li>
            <a href="/demande-devis" class="text-gray-300 hover:text-white transition-colors duration-200">Demande de Devis</a>
          </li>
          <li>
            <a href="/contact" class="text-gray-300 hover:text-white transition-colors duration-200">Contact</a>
          </li>
          <li>
            <a href="/mentions-legales" class="text-gray-300 hover:text-white transition-colors duration-200">Mentions Légales</a>
          </li>
        </ul>
      </div>
      
      <!-- Contact Info -->
      <div>
        <h3 class="font-poppins font-semibold text-lg mb-4">Contact</h3>
        <address class="not-italic">
          <div class="flex items-start mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-secondary flex-shrink-0 mt-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            <span class="text-gray-300">
              Riviera Abatta, face à l'école internationale Jules Verne<br>
              Abidjan, Côte d'Ivoire
            </span>
          </div>
          
          <div class="flex flex-col gap-2">
            {contactNumbers.map(number => (
              <div class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-secondary" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                </svg>
                <a href={`tel:${number.replace(/\s+/g, '')}`} class="text-gray-300 hover:text-white transition-colors duration-200">
                  {number}
                </a>
              </div>
            ))}
          </div>
          
          <div class="flex items-center mt-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-secondary" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
            </svg>
            <a href="mailto:contact@ibs-sarl.ci" class="text-gray-300 hover:text-white transition-colors duration-200">
              contact@ibs-sarl.ci
            </a>
          </div>
        </address>
      </div>
    </div>
    
    <div class="border-t border-gray-600 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-sm text-gray-400">
        &copy; {currentYear} IBS SARL. Tous droits réservés.
      </p>
      <div class="mt-4 md:mt-0">
        <a href="/mentions-legales" class="text-sm text-gray-400 hover:text-white transition-colors duration-200">
          Mentions Légales & Politique de Confidentialité
        </a>
      </div>
    </div>
  </div>
</footer>