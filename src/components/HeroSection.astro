---
interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  backgroundImage?: string;
}

const {
  title,
  subtitle,
  ctaText = "Demander un devis",
  ctaLink = "/demande-devis",
  secondaryCtaText,
  secondaryCtaLink,
  backgroundImage = "https://images.pexels.com/photos/2219024/pexels-photo-2219024.jpeg?auto=compress&cs=tinysrgb&h=750&w=1260"
} = Astro.props;
---

<section class="relative bg-primary overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src={backgroundImage} 
      alt="IBS SARL - Construction et menuiserie" 
      class="object-cover w-full h-full opacity-20"
    />
    <div class="absolute inset-0 bg-primary/70"></div>
  </div>
  
  <!-- Content -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-24 md:py-32">
    <div class="max-w-3xl" data-aos="fade-right" data-aos-delay="100">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">
        {title}
      </h1>
      <p class="text-xl text-gray-200 mb-8">
        {subtitle}
      </p>
      <div class="flex flex-wrap gap-4">
        <a 
          href={ctaLink} 
          class="px-6 py-3 bg-secondary hover:bg-secondary-600 text-white font-medium rounded-md transition-colors duration-300 inline-flex items-center"
        >
          {ctaText}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        
        {secondaryCtaText && secondaryCtaLink && (
          <a 
            href={secondaryCtaLink} 
            class="px-6 py-3 bg-transparent border-2 border-white text-white hover:bg-white hover:text-primary font-medium rounded-md transition-colors duration-300"
          >
            {secondaryCtaText}
          </a>
        )}
      </div>
    </div>
  </div>
  
  <!-- Wave Divider -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto text-white fill-current">
      <path d="M0,64L80,80C160,96,320,128,480,128C640,128,800,96,960,80C1120,64,1280,64,1440,64L1440,320L0,320Z"></path>
    </svg>
  </div>
</section>